rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // RSVPs Collection:
    // Enables guest RSVP submission, duplicate check, and admin management
    match /rsvps/{rsvpId} {
      // Allow reading RSVPs for guests verifying submissions and admins managing the wedding
      allow read: if true;

      // Allow creating and updating with basic data validation (guest name & contact phone required)
      allow create, update: if request.resource.data.primaryGuestName is string
                            && request.resource.data.primaryGuestName.size() > 0
                            && request.resource.data.phone is string
                            && request.resource.data.phone.size() >= 8;

      // Allow deletion for admin cleanups
      allow delete: if true;
    }

    // Admins Collection & other internal documents
    match /admins/{adminId} {
      allow read, write: if isAuthenticated();
    }

    // Fallback protection for any other collections
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
